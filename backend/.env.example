# ---- Leenk backend ----
NODE_ENV=development
PORT=5100
JWT_SECRET=change-me-to-a-long-random-string

# ---- Leenk's OWN Firebase project (leave blank to use the in-memory dev store) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ---- StudentHub federation ----
STUDENTHUB_ENABLED=false
STUDENTHUB_BASE_URL=http://localhost:5000
STUDENTHUB_APP_ID=leenk
STUDENTHUB_APP_SECRET=
STUDENTHUB_OAUTH_CLIENT_ID=leenk-dev
STUDENTHUB_OAUTH_CLIENT_SECRET=
STUDENTHUB_REDIRECT_URI=leenk://auth/callback
STUDENTHUB_WRITE_KEY=
STUDENTHUB_TIMEOUT_MS=8000

# ---- Location policy ----
LOC_MIN_INTERVAL_MS=60000
LOC_MIN_DISTANCE_M=75
LOC_MAX_SPEED_MPS=55
LOC_MAX_PER_HOUR=90
LOC_MAX_ACCURACY_M=250
LOC_GRID_PRECISION_M=250
LOC_PRESENCE_TTL_MS=300000

# ---- Discovery ----
DISCOVERY_NEARBY_KM=35
DAILY_SWIPE_CAP_FREE=25
DAILY_SUPERLIKE_FREE=1
DAILY_UNDO_FREE=3
TRUST_MIN_SWIPE=40
TRUST_SHADOW_BELOW=55
