# ============================================================
# Leenk backend — environment
#
# DESIGN RULE: this file holds ONLY what is needed to reach the
# database and verify tokens. Everything else (algorithm weights,
# ImgBB key pools, moderation thresholds, notification templates,
# GIF provider, ICE servers, feature flags) lives in Firestore
# under appConfig/* and is editable live from the admin panel.
#
# Adding a second ImgBB key must take seconds, not a redeploy.
# ============================================================

NODE_ENV=development
PORT=5100

# --- Leenk's own Firebase project (leave blank to use the in-memory dev store)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Auth
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=30d

# --- Admin panel guard
ADMIN_KEY=dev-admin-key

# --- StudentHub federation (see docs/STUDENTHUB_INTEGRATION.md)
STUDENTHUB_ENABLED=false
STUDENTHUB_BASE_URL=http://localhost:5000
STUDENTHUB_OAUTH_CLIENT_ID=leenk-dev
STUDENTHUB_OAUTH_CLIENT_SECRET=
STUDENTHUB_WRITE_KEY=
STUDENTHUB_REDIRECT_URI=leenk://auth/callback

# --- CORS
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# --- Production deployment (see DEPLOYMENT.md) ---
# Comma-separated origins allowed to call this API from a browser.
# Unset in production = allow everything, with a loud warning at boot.
# CORS_ORIGIN=https://leenk.vercel.app,https://leenk-admin.vercel.app

# Required, or the whole admin API returns 503 NO_ADMIN_KEY.
# ADMIN_KEY=

# NEVER set in production: when present this is the only accepted OTP.
# DEV_OTP_CODE=000000
