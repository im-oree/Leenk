{
  "appId": "app.leenk.mobile",
  "appName": "Leenk",
  "webDir": "dist",
  "backgroundColor": "#050506",
  "android": {
    "backgroundColor": "#050506",
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#050506"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#050506",
      "androidScaleType": "CENTER_CROP"
    },
    "Keyboard": {
      "resize": "native"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
