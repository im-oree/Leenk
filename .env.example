# Leenk frontend (Vite). Only VITE_* vars reach the browser —
# never put secrets here.

VITE_USE_API=false          # true = talk to the real backend
VITE_API_BASE=/api          # proxied to the backend in dev
VITE_APP_NAME=Leenk

# Map tiles. Defaults to OpenFreeMap (no API key, no account).
# Override to self-host, or to point at a reachable mirror on a
# restricted network. Must be a MapLibre GL style JSON URL.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
